{
  "id": "slice-review",
  "description": "Perform read-only maintainability and duplicate-scavenge review for one refactoring slice.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/slice-review.md",
  "variables": {},
  "output": {
    "description": "Return JSON containing slice id, reviewed paths, findings, duplicate-scavenge candidates, proposed tasks, conflict notes, verification suggestions, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "sliceId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "ownedPaths": {
          "type": "array",
          "items": {}
        },
        "reviewedPaths": {
          "type": "array",
          "items": {}
        },
        "findings": {
          "type": "array",
          "items": {}
        },
        "proposedTasks": {
          "type": "array",
          "items": {}
        },
        "conflictNotes": {
          "type": "array",
          "items": {}
        },
        "verificationSuggestions": {
          "type": "array",
          "items": {}
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "sliceId",
        "title"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "medium"
}
