{
  "id": "harness-recon",
  "description": "Derive attack-surface focus areas and verifier rubric using the reference harness threat-model and recon patterns.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "effort": "high",
  "promptTemplateFile": "prompts/harness-recon.md",
  "variables": {},
  "output": {
    "description": "Return threat model, verifier rubric, coverage gaps, and 3-8 complete stable securityReviewItems for native fanout.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "harnessReference": {
          "type": "object",
          "properties": {
            "sourceRepository": {
              "type": "string"
            },
            "patternsApplied": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "sourceRepository",
            "patternsApplied"
          ],
          "additionalProperties": true
        },
        "targetPath": {
          "type": "string"
        },
        "securityReviewItems": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "harnessReference",
        "targetPath",
        "securityReviewItems"
      ]
    },
    "maxValidationAttempts": 2
  }
}
