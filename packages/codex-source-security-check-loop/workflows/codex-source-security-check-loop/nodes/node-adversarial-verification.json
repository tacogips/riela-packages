{
  "id": "adversarial-verification",
  "description": "Adversarially verify, deduplicate, and rank triaged security findings before fix routing.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "effort": "high",
  "promptTemplateFile": "prompts/adversarial-verification.md",
  "variables": {},
  "output": {
    "description": "Return verified blocking findings, dismissed findings, dedupe decisions, severity/risk ranking, and residual low risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "needs_fix": {
          "type": "boolean"
        },
        "verifiedFindings": {
          "type": "array",
          "items": {}
        },
        "blockingFindings": {
          "type": "array",
          "items": {}
        },
        "verificationSummary": {
          "type": "object"
        }
      },
      "required": [
        "verificationSummary",
        "verifiedFindings",
        "blockingFindings",
        "needs_fix"
      ]
    },
    "maxValidationAttempts": 2
  }
}
