{
  "id": "exit-gate",
  "description": "Route based on blocking security findings.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/exit-gate.md",
  "variables": {},
  "output": {
    "description": "Return adapter JSON with when.needs_fix true only when high or medium findings require delegated fixes.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "needs_fix": {
          "type": "boolean"
        },
        "blockingFindingCount": {
          "type": "integer"
        },
        "blockingFindingIds": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "needs_fix",
        "blockingFindingCount",
        "blockingFindingIds"
      ]
    },
    "maxValidationAttempts": 2
  }
}
