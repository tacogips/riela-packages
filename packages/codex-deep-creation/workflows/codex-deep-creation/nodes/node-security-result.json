{
  "id": "security-result",
  "description": "Summarize the accepted source security check result.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/security-result.md",
  "variables": {},
  "output": {
    "description": "Return security status, findings, fixed issues, verification, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "securityWorkflowId": {
          "type": "string"
        },
        "securityStatus": {
          "type": "string"
        },
        "verifiedFindings": {
          "type": "array",
          "items": {}
        },
        "delegatedWorkflowRuns": {
          "type": "array",
          "items": {}
        },
        "changedFiles": {
          "type": "array",
          "items": {}
        },
        "verification": {
          "type": "array",
          "items": {}
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        },
        "coverageGaps": {
          "type": "array",
          "items": {}
        },
        "handoffSummary": {
          "type": "string"
        }
      },
      "required": [
        "securityWorkflowId",
        "securityStatus"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "medium"
}
