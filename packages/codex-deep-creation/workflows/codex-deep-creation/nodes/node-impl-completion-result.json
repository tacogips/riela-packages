{
  "id": "impl-completion-result",
  "description": "Summarize the accepted implementation-plan completion result.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/impl-completion-result.md",
  "variables": {},
  "output": {
    "description": "Return completed plans, changed files, verification evidence, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "implCompletionWorkflowId": {
          "type": "string"
        },
        "implCompletionStatus": {
          "type": "string"
        },
        "completedPlans": {
          "type": "array",
          "items": {}
        },
        "activePlansRemaining": {
          "type": "array",
          "items": {}
        },
        "delegatedWorkflowRuns": {
          "type": "array",
          "items": {}
        },
        "changedFiles": {
          "type": "array",
          "items": {}
        },
        "verification": {
          "type": "array",
          "items": {}
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        },
        "handoffSummary": {
          "type": "string"
        }
      },
      "required": [
        "implCompletionWorkflowId",
        "implCompletionStatus"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "medium"
}
