{
  "id": "creation-manager",
  "description": "Normalize a full deep creation request for design, implementation-plan completion, and security checking.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/creation-manager.md",
  "variables": {},
  "output": {
    "description": "Return normalized feature, design, implementation-plan, security, target path, and constraint inputs.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "feature": {
          "type": "string"
        },
        "targetDesignDoc": {
          "type": "string"
        },
        "targetPaths": {
          "type": "array",
          "items": {}
        },
        "securityTargetPath": {
          "type": "string"
        },
        "deepdesignInput": {
          "type": "object"
        },
        "implCompletionInput": {
          "type": "object"
        },
        "securityInput": {
          "type": "object"
        },
        "constraints": {
          "type": "array",
          "items": {}
        },
        "handoffSummary": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "targetDesignDoc"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "high"
}
