{
  "id": "base-branch-integrate",
  "description": "All parallel workers have stopped; final commit and push have succeeded. Perform serialized integration only now.",
  "executionBackend": "claude-code-agent",
  "model": "claude-opus-5-5",
  "promptTemplateFile": "prompts/base-branch-integrate.md",
  "variables": {},
  "effort": "high",
  "agentSandbox": "workspace-write",
  "output": {
    "jsonSchema": {
      "type": "object",
      "properties": {
        "implementationBranch": {
          "type": "string",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "implementationCommit": {
          "type": "string",
          "minLength": 1
        },
        "mergeCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "mergeStatus": {
          "type": "string",
          "minLength": 1
        },
        "basePushStatus": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "implementationBranch",
        "baseBranch",
        "implementationCommit",
        "mergeStatus",
        "basePushStatus"
      ],
      "additionalProperties": true
    },
    "maxValidationAttempts": 2,
    "description": "Return verified base integration and push status."
  }
}
