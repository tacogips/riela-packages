{
  "id": "step9-commit-message",
  "description": "Verify plan completion and archive for issue-resolution, then prepare commit evidence; preserve active plans for planning-only.",
  "executionBackend": "claude-code-agent",
  "model": "claude-opus-5-5",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/step9-commit-message.md",
  "variables": {},
  "output": {
    "description": "Return adapter JSON with when.needs_revision, payload.needs_revision, completion evidence and, only on acceptance, commitMessage, committedFiles, changeSummary.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "workflowMode": {
          "type": "string",
          "enum": [
            "planning-only",
            "issue-resolution"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "needs-revision",
            "accepted"
          ]
        },
        "needs_revision": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "findings": {
          "type": "array"
        },
        "checkedImplPlanPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activeImplPlanFindings": {
          "type": "array"
        },
        "archivedImplPlanPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updatedIndexFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completionSummary": {
          "type": "string"
        },
        "residualRisks": {
          "type": "array"
        },
        "commitMessage": {
          "type": "string",
          "minLength": 1
        },
        "committedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changeSummary": {
          "type": "string"
        },
        "git": {
          "type": "object",
          "properties": {
            "commitHash": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "workflowMode",
        "decision",
        "needs_revision",
        "checkedImplPlanPaths",
        "activeImplPlanFindings",
        "archivedImplPlanPaths",
        "updatedIndexFiles",
        "completionSummary",
        "residualRisks"
      ],
      "anyOf": [
        {
          "properties": {
            "decision": {
              "const": "needs-revision"
            },
            "needs_revision": {
              "const": true
            }
          },
          "required": [
            "decision",
            "needs_revision"
          ]
        },
        {
          "properties": {
            "decision": {
              "const": "accepted"
            },
            "needs_revision": {
              "const": false
            },
            "accepted": {
              "const": true
            },
            "findings": {
              "type": "array",
              "maxItems": 0
            }
          },
          "required": [
            "decision",
            "needs_revision",
            "accepted",
            "findings",
            "commitMessage",
            "committedFiles",
            "changeSummary"
          ]
        }
      ],
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  },
  "agentSandbox": "workspace-write"
}
