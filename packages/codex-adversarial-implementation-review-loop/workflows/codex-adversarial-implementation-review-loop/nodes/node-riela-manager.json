{
  "id": "riela-manager",
  "description": "Normalize adversarial implementation review inputs and decide whether to run an initial implementation handoff.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/riela-manager.md",
  "variables": {},
  "output": {
    "description": "Return normalized review subject, implementation input, target paths, constraints, skip_initial_implementation route boolean, and routing notes.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reviewSubject": {
          "type": "string"
        },
        "implementationInput": {
          "type": "object"
        },
        "skip_initial_implementation": {
          "type": "boolean"
        },
        "targetPaths": {
          "type": "array",
          "items": {}
        },
        "changedFiles": {
          "type": "array",
          "items": {}
        },
        "implementationEvidence": {
          "type": "array",
          "items": {}
        },
        "constraints": {
          "type": "array",
          "items": {}
        },
        "routingDecision": {
          "type": "string"
        }
      },
      "required": [
        "reviewSubject",
        "implementationInput"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "high"
}
