{
  "id": "adversarial-review",
  "description": "Perform read-only adversarial implementation review against the explicit review subject.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/adversarial-review.md",
  "variables": {},
  "output": {
    "description": "Return findings, severity, reviewed paths, verification gaps, needs_fix boolean, residual risks, and accepted status.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reviewId": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        },
        "reviewSubject": {
          "type": "string"
        },
        "reviewedPaths": {
          "type": "array",
          "items": {}
        },
        "changedFiles": {
          "type": "array",
          "items": {}
        },
        "verification": {
          "type": "array",
          "items": {}
        },
        "reviewSummary": {
          "type": "string"
        }
      },
      "required": [
        "reviewId",
        "accepted"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "medium"
}
