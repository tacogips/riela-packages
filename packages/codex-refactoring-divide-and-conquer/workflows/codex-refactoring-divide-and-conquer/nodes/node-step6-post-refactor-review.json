        },
        "plan_remaining": {
          "type": "string"
        },
        "workflow_complete": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "needs_revision",
        "plan_remaining",
        "workflow_complete",
        "accepted"
      ]
    },
    "maxValidationAttempts": 2
  },
