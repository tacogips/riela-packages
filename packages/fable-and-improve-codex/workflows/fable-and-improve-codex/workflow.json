{
  "workflowId": "fable-and-improve-codex",
  "description": "Claude Fable analyzes the request, recalls prior knowledge from the kaiba knowledge base, authors the design and implementation plan, Codex implements with GPT-5.6 SOL and independently reviews with GPT-5.6 Terra, Fable verifies completion, and a self-review step feeds durable lessons back into the knowledge base before the final output. Accepted plans are committed before same-branch parallel implementation/review, overwrite reconciliation and serialized Git finalization.",
  "defaults": {
    "maxLoopIterations": 30,
    "nodeTimeoutMs": 3600000,
    "supervision": {
      "monitorIntervalMs": 15000,
      "stallTimeoutMs": 300000
    },
    "fanoutConcurrency": 4
  },
  "prompts": {
    "rielaPromptTemplate": "Fable authors the design and all plans in one node after analysis and knowledge recall. Commit the accepted plans before same-branch Riela implementation/review fanout. Join all workers, reconcile overwritten changes, independently review the combined tree, then dispatch dependency-ready later waves. Fable confirms the goal before serialized commit, push and base integration, then knowledge self-review. No worktrees or parallel Git operations.",
    "workerSystemPromptTemplate": "Return concise business JSON only. Preserve analysis, design and implementation-plan artifacts, changed files, verification evidence, review findings, remaining TODOs, and residual risks."
  },
  "managerStepId": "fable-analysis",
  "entryStepId": "fable-analysis",
  "nodes": [
    {
      "id": "fable-analysis",
      "nodeFile": "nodes/node-fable-analysis.json"
    },
    {
      "id": "kb-recall-prior",
      "addon": {
        "name": "kaiba/memory-recall",
        "version": "1",
        "config": {
          "query": "{{knowledgeQuery}}",
          "limit": 5,
          "includeAssociations": true,
          "associationDepth": 2
        }
      }
    },
    {
      "id": "fable-design",
      "nodeFile": "nodes/node-fable-design.json"
    },
    {
      "id": "codex-implementation",
      "nodeFile": "nodes/node-codex-implementation.json"
    },
    {
      "id": "codex-review",
      "nodeFile": "nodes/node-codex-review.json"
    },
    {
      "id": "fable-goal-review",
      "nodeFile": "nodes/node-fable-goal-review.json"
    },
    {
      "id": "kb-self-review",
      "nodeFile": "nodes/node-kb-self-review.json"
    },
    {
      "id": "kb-recall-related",
      "addon": {
        "name": "kaiba/memory-recall",
        "version": "1",
        "config": {
          "query": "{{knowledgeQuery}}",
          "limit": 5,
          "includeAssociations": true,
          "associationDepth": 2,
          "passthrough": "{\"candidateContent\":\"{{candidateContent}}\",\"candidateTags\":\"{{candidateTags}}\",\"knowledgeQuery\":\"{{knowledgeQuery}}\"}"
        }
      }
    },
    {
      "id": "kb-merge-judge",
      "nodeFile": "nodes/node-kb-merge-judge.json"
    },
    {
      "id": "kb-create",
      "addon": {
        "name": "kaiba/memory-consolidate",
        "version": "1",
        "config": {
          "autoAssociate": true,
          "associationLimit": 8
        }
      }
    },
    {
      "id": "kb-merge",
      "addon": {
        "name": "kaiba/note-update",
        "version": "1",
        "config": {
          "noteId": "{{mergeNoteId}}",
          "bodyMarkdown": "{{mergedBody}}"
        }
      }
    },
    {
      "id": "kb-archive-brief",
      "nodeFile": "nodes/node-kb-archive-brief.json"
    },
    {
      "id": "kb-archive",
      "addon": {
        "name": "kaiba/note-update",
        "version": "1",
        "config": {
          "noteId": "{{archiveNoteId}}",
          "bodyMarkdown": "{{archivedPointerBody}}"
        }
      }
    },
    {
      "id": "final-output",
      "kind": "output",
      "nodeFile": "nodes/node-final-output.json"
    },
    {
      "id": "plan-checkpoint",
      "nodeFile": "nodes/node-plan-checkpoint.json"
    },
    {
      "id": "plan-git-commit",
      "addon": {
        "name": "riela/git-commit",
        "version": "1",
        "config": {
          "commitMessageTemplate": "{{inbox.latest.output.payload.commitMessage}}",
          "committedFilesTemplate": "{{inbox.latest.output.payload.committedFiles}}",
          "allowCommit": true
        }
      }
    },
    {
      "id": "dispatch-plans",
      "nodeFile": "nodes/node-dispatch-plans.json"
    },
    {
      "id": "branch-evidence",
      "nodeFile": "nodes/node-branch-evidence.json"
    },
    {
      "id": "reconcile-implementations",
      "nodeFile": "nodes/node-reconcile-implementations.json"
    },
    {
      "id": "integration-review",
      "nodeFile": "nodes/node-integration-review.json"
    },
    {
      "id": "step9-commit-message",
      "nodeFile": "nodes/node-step9-commit-message.json"
    },
    {
      "id": "step10-git-commit",
      "addon": {
        "name": "riela/git-commit",
        "version": "1",
        "config": {
          "commitMessageTemplate": "{{inbox.latest.output.payload.commitMessage}}",
          "committedFilesTemplate": "{{inbox.latest.output.payload.committedFiles}}",
          "allowCommit": true
        }
      }
    },
    {
      "id": "step11-git-push",
      "addon": {
        "name": "riela/git-push",
        "version": "1",
        "config": {
          "allowPush": true,
          "expectedCommitHashTemplate": "{{inbox.latest.output.payload.git.commitHash}}"
        }
      }
    },
    {
      "id": "base-branch-integrate",
      "nodeFile": "nodes/node-base-branch-integrate.json"
    }
  ],
  "steps": [
    {
      "id": "fable-analysis",
      "nodeId": "fable-analysis",
      "description": "Use Fable to analyze the operator request, repository state, constraints, risks, and testable acceptance criteria, and to name a knowledge-base search keyword.",
      "role": "manager",
      "transitions": [
        {
          "toStepId": "kb-recall-prior"
        }
      ]
    },
    {
      "id": "kb-recall-prior",
      "nodeId": "kb-recall-prior",
      "description": "Recall durable prior knowledge from the kaiba knowledge base for the analysis topic before design starts.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "fable-design"
        }
      ]
    },
    {
      "id": "fable-design",
      "nodeId": "fable-design",
      "description": "Author design, implementation plan, and their consistency self-check in one Fable execution.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "fable-analysis"
      },
      "transitions": [
        {
          "toStepId": "plan-checkpoint"
        }
      ]
    },
    {
      "id": "codex-implementation",
      "nodeId": "codex-implementation",
      "description": "Use Codex GPT-5.6 Terra to implement or improve the current Fable-authored plan and verify the result.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "codex-review"
        }
      ]
    },
    {
      "id": "codex-review",
      "nodeId": "codex-review",
      "description": "Use an independent Codex GPT-5.6 SOL session to review the implementation and request concrete fixes.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "codex-implementation",
          "label": "needs_revision"
        },
        {
          "toStepId": "branch-evidence",
          "label": "!(needs_revision)"
        }
      ]
    },
    {
      "id": "fable-goal-review",
      "nodeId": "fable-goal-review",
      "description": "Use Fable to compare the accepted Codex result with the analysis, design, plan, and goal.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "fable-analysis"
      },
      "transitions": [
        {
          "toStepId": "fable-analysis",
          "label": "needs_replan"
        },
        {
          "toStepId": "reconcile-implementations",
          "label": "needs_todo"
        },
        {
          "toStepId": "step9-commit-message",
          "label": "!(needs_replan || needs_todo)"
        }
      ]
    },
    {
      "id": "kb-self-review",
      "nodeId": "kb-self-review",
      "description": "Use Fable to self-review the accepted run and extract at most one durable knowledge candidate for the knowledge base.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "fable-goal-review"
      },
      "transitions": [
        {
          "toStepId": "kb-recall-related"
        }
      ]
    },
    {
      "id": "kb-recall-related",
      "nodeId": "kb-recall-related",
      "description": "Recall existing knowledge-base notes related to the self-review candidate.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "kb-merge-judge"
        }
      ]
    },
    {
      "id": "kb-merge-judge",
      "nodeId": "kb-merge-judge",
      "description": "Use Fable to decide whether the candidate knowledge is created, merged into an existing note, or skipped.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "kb-self-review"
      },
      "transitions": [
        {
          "toStepId": "kb-create",
          "label": "create_knowledge"
        },
        {
          "toStepId": "kb-merge",
          "label": "merge_knowledge"
        },
        {
          "toStepId": "final-output",
          "label": "!(create_knowledge || merge_knowledge)"
        }
      ]
    },
    {
      "id": "kb-create",
      "nodeId": "kb-create",
      "description": "Write the accepted candidate as a new kaiba knowledge-base note with graph auto-association.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "final-output"
        }
      ]
    },
    {
      "id": "kb-merge",
      "nodeId": "kb-merge",
      "description": "Rewrite the existing kaiba note with the generalized merged body so the knowledge base absorbs the lesson without growing.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "kb-archive-brief"
        }
      ]
    },
    {
      "id": "kb-archive-brief",
      "nodeId": "kb-archive-brief",
      "description": "Use the merge judge's session to re-emit the archive instruction after the merge write.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "kb-merge-judge"
      },
      "transitions": [
        {
          "toStepId": "kb-archive",
          "label": "archive_note"
        },
        {
          "toStepId": "final-output",
          "label": "!(archive_note)"
        }
      ]
    },
    {
      "id": "kb-archive",
      "nodeId": "kb-archive",
      "description": "Collapse the superseded kaiba note to a one-line pointer so stale copies stop matching searches.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "final-output"
        }
      ]
    },
    {
      "id": "final-output",
      "nodeId": "final-output",
      "description": "Publish the accepted Fable analysis, design, implementation plan, Codex evidence, knowledge-base update, and final status.",
      "role": "worker",
      "sessionPolicy": {
        "mode": "reuse",
        "inheritFromStepId": "kb-merge-judge"
      }
    },
    {
      "id": "plan-checkpoint",
      "nodeId": "plan-checkpoint",
      "description": "Prepare the accepted design and plan checkpoint without staging unrelated changes.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "plan-git-commit"
        }
      ]
    },
    {
      "id": "plan-git-commit",
      "nodeId": "plan-git-commit",
      "description": "Commit accepted designs, plans and dispatch manifest before any implementation.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "dispatch-plans"
        }
      ]
    },
    {
      "id": "dispatch-plans",
      "nodeId": "dispatch-plans",
      "description": "Select a dependency-ready wave from the committed plan manifest.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "codex-implementation",
          "fanout": {
            "groupId": "shared-branch-implementation",
            "itemsFrom": "/implementationItems",
            "itemVariable": "implementation",
            "concurrency": 4,
            "joinStepId": "reconcile-implementations",
            "failurePolicy": "collect-partial",
            "resultOrder": "input",
            "dependencies": {
              "branchIdFrom": "/planId",
              "dependsOnFrom": "/dependsOn",
              "completedBranchIdsFrom": "/acceptedPlanIds"
            },
            "changeTracking": {
              "pathsFrom": "/trackedPaths"
            },
            "writeOwnership": {
              "mode": "shared-workspace"
            }
          }
        }
      ]
    },
    {
      "id": "branch-evidence",
      "nodeId": "branch-evidence",
      "description": "Record branch evidence after accepted reviews; never finalize git in a parallel branch.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "reconcile-implementations"
        }
      ]
    },
    {
      "id": "reconcile-implementations",
      "nodeId": "reconcile-implementations",
      "description": "After all workers stop, detect and repair overwritten or missing changes and run combined verification.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "integration-review"
        }
      ]
    },
    {
      "id": "integration-review",
      "nodeId": "integration-review",
      "description": "Independently verify retained plan behavior and repairs before another wave or finalization.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "reconcile-implementations",
          "label": "needs_revision"
        },
        {
          "toStepId": "dispatch-plans",
          "label": "!(needs_revision) && plans_remaining"
        },
        {
          "toStepId": "fable-goal-review",
          "label": "!(needs_revision || plans_remaining)"
        }
      ]
    },
    {
      "id": "step9-commit-message",
      "nodeId": "step9-commit-message",
      "description": "Check completion for issue-resolution and prepare commit evidence; planning-only preserves active plans.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "fable-goal-review",
          "label": "needs_revision"
        },
        {
          "toStepId": "step10-git-commit",
          "label": "!(needs_revision)"
        }
      ]
    },
    {
      "id": "step10-git-commit",
      "nodeId": "step10-git-commit",
      "description": "Use the shared built-in git commit node to stage and commit the accepted workflow changes from Step 9.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "step11-git-push"
        }
      ]
    },
    {
      "id": "step11-git-push",
      "nodeId": "step11-git-push",
      "description": "Use the built-in git push node to push the commit created by Step 10 to the current branch.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "base-branch-integrate"
        }
      ]
    },
    {
      "id": "base-branch-integrate",
      "nodeId": "base-branch-integrate",
      "description": "Serially integrate the verified pushed branch into the recorded base branch and push the base.",
      "role": "worker",
      "transitions": [
        {
          "toStepId": "kb-self-review"
        }
      ]
    }
  ],
  "metadata": {
    "rielaPackage": {
      "title": "fable-and-improve-codex",
      "description": "Claude Fable analyzes the request, recalls prior knowledge from the kaiba knowledge base, authors the design and implementation plan, Codex implements with GPT-5.6 SOL and independently reviews with GPT-5.6 Terra, Fable verifies completion, and a self-review step feeds durable lessons back into the knowledge base before the final output. Accepted plans are committed before same-branch parallel implementation/review, overwrite reconciliation and serialized Git finalization.",
      "tags": [
        "workflow",
        "claude-code",
        "codex",
        "fable",
        "review",
        "knowledge-base"
      ],
      "backends": [
        "claude-code-agent",
        "codex-agent"
      ]
    }
  }
}
