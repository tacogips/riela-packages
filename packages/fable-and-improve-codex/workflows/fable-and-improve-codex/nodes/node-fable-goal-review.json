{
  "id": "fable-goal-review",
  "description": "Claude Fable verifies whether the accepted SOL implementation and SOL review satisfy the analysis, design, plan, and goal.",
  "executionBackend": "claude-code-agent",
  "agentSandbox": "danger-full-access",
  "model": "claude-fable-5",
  "modelFreeze": true,
  "effort": "high",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "promptTemplateFile": "prompts/fable-goal-review.md",
  "output": {
    "description": "Return routing decisions, goal completion, remaining TODOs, verification and review evidence, changed files, and residual risks.",
    "maxValidationAttempts": 2,
    "jsonSchema": {
      "type": "object",
      "properties": {
        "goalAchieved": {
          "type": "boolean"
        },
        "completionDecision": {
          "type": "string"
        },
        "evidence": {
          "type": "array"
        },
        "remainingTodos": {
          "type": "array"
        },
        "replanReason": {},
        "followUpImplementationHint": {},
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationEvidence": {
          "type": "array"
        },
        "reviewEvidence": {
          "type": "array"
        },
        "residualRisks": {
          "type": "array"
        },
        "operatorNotes": {
          "type": "array"
        }
      },
      "required": [
        "goalAchieved",
        "completionDecision",
        "evidence",
        "remainingTodos",
        "replanReason",
        "followUpImplementationHint",
        "changedFiles",
        "verificationEvidence",
        "reviewEvidence",
        "residualRisks",
        "operatorNotes"
      ],
      "additionalProperties": true
    }
  }
}
