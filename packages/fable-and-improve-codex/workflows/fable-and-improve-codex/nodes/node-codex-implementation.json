{
  "id": "codex-implementation",
  "description": "Codex GPT-5.6 SOL low effort implements the Fable-authored plan and addresses review findings or follow-up TODOs.",
  "executionBackend": "codex-agent",
  "agentSandbox": "workspace-write",
  "model": "gpt-5.6-sol",
  "modelFreeze": true,
  "effort": "low",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "promptTemplateFile": "prompts/codex-implementation.md",
  "variables": {},
  "output": {
    "description": "Return implementation progress, changed paths and verification evidence.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "implementationStatus": {
          "type": "string",
          "minLength": 1
        },
        "implementationSummary": {
          "type": "string",
          "minLength": 1
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "testsAddedOrUpdated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "documentationUpdated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementationPlanUpdates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "residualRisks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "implementationSummary",
        "changedFiles"
      ],
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  }
}
