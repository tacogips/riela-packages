{
  "id": "kb-archive-brief",
  "description": "Claude Fable re-emits the archive part of the merge decision so the archive step can apply it after the merge write.",
  "executionBackend": "claude-code-agent",
  "model": "claude-fable-5",
  "modelFreeze": true,
  "effort": "medium",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "promptTemplateFile": "prompts/kb-archive-brief.md",
  "output": {
    "description": "Return the archive instruction decided by the merge judge.",
    "jsonSchema": {
      "type": "object",
      "required": [
        "archive_note"
      ],
      "properties": {
        "archive_note": {
          "type": "boolean"
        },
        "archiveNoteId": {
          "type": "string"
        },
        "archivedPointerBody": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "properties": {
            "archive_note": {
              "const": true
            },
            "archiveNoteId": {
              "type": "string",
              "minLength": 1
            },
            "archivedPointerBody": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "archive_note",
            "archiveNoteId",
            "archivedPointerBody"
          ]
        },
        {
          "properties": {
            "archive_note": {
              "const": false
            }
          },
          "required": [
            "archive_note"
          ]
        }
      ]
    },
    "maxValidationAttempts": 2
  },
  "agentSandbox": "read-only"
}
