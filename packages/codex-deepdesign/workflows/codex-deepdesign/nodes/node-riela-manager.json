{
  "id": "riela-manager",
  "description": "Coordinate the deep design workflow.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/riela-manager.md",
  "variables": {},
  "input": {
    "description": "Workflow arguments describing the feature, target design-doc path, repository scope, known constraints, and optional acceptance criteria.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "feature": {
          "type": "string",
          "minLength": 1,
          "description": "Feature or capability to design."
        },
        "targetDesignDoc": {
          "type": "string",
          "minLength": 1,
          "description": "Optional preferred design-doc path under design-docs/."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Known technical, product, migration, or compatibility constraints."
        }
      }
    }
  },
  "output": {
    "description": "Return normalized design request context for Node 1 and both review nodes.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "feature": {
          "type": "string"
        },
        "targetDesignDoc": {
          "type": "string"
        },
        "targetScope": {
          "type": "array",
          "items": {}
        },
        "constraints": {
          "type": "array",
          "items": {}
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {}
        },
        "nonGoals": {
          "type": "array",
          "items": {}
        },
        "provisionalDecisionPolicy": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "feature",
        "targetDesignDoc"
      ]
    },
    "maxValidationAttempts": 2
  }
}
