{
  "id": "task-commit-message",
  "description": "Generate the commit message and exact files for the completed watchdog task and reviewed project-scope skill changes.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/task-commit-message.md",
  "variables": {},
  "output": {
    "description": "Return JSON with commitMessage, committedFiles, task id, skill changes, review summary, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "commitMessage": {
          "type": "string"
        },
        "committedFiles": {
          "type": "array",
          "items": {}
        },
        "taskId": {
          "type": "string"
        },
        "skillChanges": {
          "type": "array",
          "items": {}
        },
        "reviewSummary": {
          "type": "string"
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "commitMessage",
        "committedFiles"
      ]
    },
    "maxValidationAttempts": 2
  }
}
