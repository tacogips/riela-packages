{
  "id": "skill-review",
  "description": "Review and correct project-scope skill changes created from the completed task log.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/skill-review.md",
  "variables": {},
  "output": {
    "description": "Return JSON with review verdict, findings fixed, accepted skill files, rejected skill files, and remaining risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "taskId": {
          "type": "string"
        },
        "verdict": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {}
        },
        "fixedFiles": {
          "type": "array",
          "items": {}
        },
        "acceptedSkillFiles": {
          "type": "boolean"
        },
        "rejectedSkillFiles": {
          "type": "array",
          "items": {}
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "taskId",
        "verdict"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "high"
}
