  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/handoff-design-impl.md",
  "variables": {},
  "output": {
    "description": "Return workflowInput, task, and handoffSummary for codex-design-and-implement-review-loop.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "workflowInput": {
          "type": "object"
        },
        "task": {
          "type": "string"
        },
        "reviewContext": {
          "type": "object"
        },
        "handoffSummary": {
          "type": "string"
        }
      },
      "required": [
        "workflowInput",
        "task"
      ]
    },
    "maxValidationAttempts": 2
  }
}
