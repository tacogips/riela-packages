{
  "id": "skill-opportunity-mining",
  "description": "Review the completed task Codex log and create or update warranted project-scope skills.",
  "executionBackend": "codex-agent",
  "agentSandbox": "workspace-write",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/skill-opportunity-mining.md",
  "variables": {},
  "output": {
    "description": "Return JSON with log sources reviewed, extracted skill opportunities, created or updated .agents/skills files, skipped opportunities, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "taskId": {
          "type": "string"
        },
        "logSourcesReviewed": {
          "type": "string"
        },
        "skillOpportunities": {
          "type": "string"
        },
        "createdSkillFiles": {
          "type": "array",
          "items": {}
        },
        "updatedSkillFiles": {
          "type": "array",
          "items": {}
        },
        "skippedOpportunities": {
          "type": "string"
        },
        "residualRisks": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "taskId",
        "logSourcesReviewed"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "high"
}
