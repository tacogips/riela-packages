{
  "id": "step5-impl-plan-review",
  "description": "Review the implementation plan against the design, including final design-plan consistency, and route back to the right authoring step when blocking findings exist. Return detailed revision instructions to the owning author without editing or repair delegation.",
  "executionBackend": "claude-code-agent",
  "agentSandbox": "read-only",
  "model": "claude-opus-5-5",
  "modelFreeze": false,
  "effort": "high",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "systemPromptTemplateFile": "prompts/runtime-provenance-system.md",
  "promptTemplateFile": "prompts/step5-impl-plan-review.md",
  "variables": {},
  "output": {
    "description": "Return adapter JSON with when.needs_design_revision or when.needs_revision for blocking findings, plus when.planning_only to signal planning-only completion.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "needs_design_revision": {
          "type": "boolean"
        },
        "needs_revision": {
          "type": "boolean"
        },
        "planning_only": {
          "type": "boolean"
        },
        "repairRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "findingId": {
                "type": "string",
                "minLength": 1
              },
              "planId": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "intentReference": {
                "type": "string",
                "minLength": 1
              },
              "materialImpact": {
                "type": "string",
                "minLength": 1
              },
              "reproduction": {
                "type": "string",
                "minLength": 1
              },
              "rootCause": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "findingId",
              "severity",
              "file",
              "intentReference",
              "materialImpact",
              "reproduction",
              "rootCause",
              "allowedWritePaths",
              "forbiddenChanges",
              "orderedChanges",
              "verification",
              "completionCriteria"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "needs_design_revision",
        "needs_revision",
        "planning_only"
      ],
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  }
}
