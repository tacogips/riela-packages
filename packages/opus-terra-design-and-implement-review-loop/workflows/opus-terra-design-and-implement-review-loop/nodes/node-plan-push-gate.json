{
  "id": "plan-push-gate",
  "description": "Decide whether the accepted plan checkpoint commit is pushed before implementation dispatch (workflowInput.gitPush, default true).",
  "nodeType": "command",
  "command": {
    "scriptPath": "scripts/git-push-gate.py"
  },
  "variables": {},
  "output": {
    "description": "Forward the accepted riela/git-commit payload with gitPush and the routing booleans push / local_only.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "git": {
          "type": "object",
          "properties": {
            "operation": {
              "const": "commit"
            },
            "commitHash": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "operation",
            "commitHash"
          ]
        },
        "gitPush": {
          "type": "boolean"
        },
        "push": {
          "type": "boolean"
        },
        "local_only": {
          "type": "boolean"
        }
      },
      "required": [
        "git",
        "gitPush",
        "push",
        "local_only"
      ]
    }
  }
}
