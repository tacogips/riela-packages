{
  "id": "asset-generate",
  "description": "Generate or revise image and media assets for the SolidJS website with Codex GPT-5.6 SOL high effort.",
  "executionBackend": "codex-agent",
  "agentSandbox": "workspace-write",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "effort": "high",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "promptTemplateFile": "prompts/asset-generate.md",
  "variables": {},
  "output": {
    "description": "Return asset paths, generation method, usage map, licensing/provenance notes, and implementation guidance.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "targetDirectory": {
          "type": "string"
        },
        "assetFiles": {
          "type": "array",
          "items": {}
        },
        "assetUsageMap": {
          "type": "string"
        },
        "generationMethods": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "licensingNotes": {
          "type": "array",
          "items": {}
        },
        "fallbacksUsed": {
          "type": "string"
        },
        "addressedFeedback": {
          "type": "array",
          "items": {}
        },
        "implementationGuidance": {
          "type": "array",
          "items": {}
        },
        "residualAssetRisks": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "targetDirectory",
        "assetFiles"
      ]
    },
    "maxValidationAttempts": 2
  }
}
