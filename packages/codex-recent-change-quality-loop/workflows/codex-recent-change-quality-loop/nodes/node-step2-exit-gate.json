{
  "id": "step2-exit-gate",
  "description": "Reduce all parallel review results and route based on merged severity and branch integrity.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/step2-exit-gate.md",
  "variables": {},
  "output": {
    "description": "Return adapter JSON with merged findings and when.needs_fix true when any branch failed or reported high/mid findings.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "needs_fix": {
          "type": "boolean"
        },
        "blockingFindingCount": {
          "type": "integer"
        },
        "blockingFindings": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "needs_fix",
        "blockingFindingCount",
        "blockingFindings"
      ]
    },
    "maxValidationAttempts": 2
  },
  "effort": "high"
}
