{
  "id": "base-branch-integrate",
  "description": "All parallel workers have stopped; final commit and push have succeeded. Verify PR handoff or perform authorized serialized base integration.",
  "executionBackend": "codex-agent",
  "agentSandbox": "danger-full-access",
  "model": "gpt-6-sol",
  "promptTemplateFile": "prompts/base-branch-integrate.md",
  "variables": {},
  "effort": "medium",
  "output": {
    "description": "Return only verified PR handoff or successful base integration evidence; a blocked or failed operation must fail this step.",
    "jsonSchema": {
      "type": "object",
      "required": ["implementationBranch", "baseBranch", "remote", "implementationCommit", "mergeStatus", "basePushStatus", "verification"],
      "properties": {
        "implementationBranch": { "type": "string" },
        "baseBranch": { "type": "string" },
        "remote": { "type": "string" },
        "implementationCommit": { "type": "string" },
        "mergeStatus": { "type": "string", "enum": ["merged", "already-on-base", "already-merged", "pr-open"] },
        "basePushStatus": { "type": "string", "enum": ["pushed", "already-pushed", "not-requested"] },
        "pullRequestURL": { "type": "string" },
        "pullRequestNumber": { "type": "integer" },
        "pullRequestDraft": { "type": "boolean" },
        "pullRequestBaseBranch": { "type": "string" },
        "verification": { "type": "object" }
      },
      "additionalProperties": true
    },
    "maxValidationAttempts": 2
  }
}
