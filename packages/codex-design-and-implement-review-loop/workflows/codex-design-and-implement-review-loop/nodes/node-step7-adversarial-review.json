{
  "id": "step7-adversarial-review",
  "description": "Adversarially review a high-risk accepted implementation for failure modes, misuse paths, misleading success states, and verification loopholes.",
  "executionBackend": "codex-agent",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "effort": "medium",
  "promptTemplateFile": "prompts/step7-adversarial-review.md",
  "variables": {},
  "output": {
    "description": "Return an auditable security review basis and only route credible, materially impactful, proportionate adversarial findings.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "needs_revision": { "type": "boolean" },
        "accepted": { "type": "boolean" },
        "reviewBasis": {
          "type": "object",
          "properties": {
            "protectedOutcomes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "trustBoundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "intentionalTradeoffs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "sourcePaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          },
          "required": ["protectedOutcomes", "trustBoundaries", "nonGoals", "intentionalTradeoffs", "sourcePaths"],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "type": "string", "enum": ["high", "mid", "low"] },
              "file": { "type": "string", "minLength": 1 },
              "line": { "type": "number", "minimum": 1 },
              "message": { "type": "string", "minLength": 1 },
              "attackOrFailurePath": { "type": "string", "minLength": 1 },
              "recommendedChange": { "type": "string", "minLength": 1 },
              "intentReference": { "type": "string", "minLength": 1 },
              "materialImpact": { "type": "string", "minLength": 1 },
              "fixCostBenefit": { "type": "string", "minLength": 1 }
            },
            "required": ["severity", "file", "message", "attackOrFailurePath", "recommendedChange", "intentReference", "materialImpact", "fixCostBenefit"],
            "additionalProperties": false
          }
        },
        "feedback": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "adversarialReviewSummary": { "type": "string", "minLength": 1 },
        "residualLowRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["needs_revision", "accepted", "reviewBasis", "findings", "feedback", "adversarialReviewSummary", "residualLowRisks"],
      "additionalProperties": false
    }
  }
}
