{
  "id": "step4-impl-plan-create",
  "description": "Create or revise the implementation plan that executes the accepted design, including Codex-reference traceability when relevant.",
  "executionBackend": "codex-agent",
  "agentSandbox": "workspace-write",
  "model": "gpt-6-astra",
  "modelFreeze": false,
  "effort": "medium",
  "sessionPolicy": {
    "mode": "reuse"
  },
  "systemPromptTemplateFile": "prompts/runtime-provenance-system.md",
  "promptTemplateFile": "prompts/step4-impl-plan-create.md",
  "variables": {},
  "output": {
    "description": "Return JSON with implementation-plan paths, design and Codex references, task breakdown, verification plan, and addressed feedback.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "workflowMode": {
          "type": "string"
        },
        "implPlanPaths": {
          "type": "array",
          "items": {}
        },
        "issueReference": {
          "type": "string"
        },
        "designReferences": {
          "type": "array",
          "items": {}
        },
        "codexAgentReferences": {
          "type": "array",
          "items": {}
        },
        "taskBreakdown": {
          "type": "array",
          "items": {}
        },
        "dependencies": {
          "type": "array",
          "items": {}
        },
        "parallelizableTasks": {
          "type": "array",
          "items": {}
        },
        "verification": {
          "type": "array",
          "items": {}
        },
        "completionCriteria": {
          "type": "array",
          "items": {}
        },
        "addressedFeedback": {
          "type": "array",
          "items": {}
        },
        "risks": {
          "type": "array",
          "items": {}
        },
        "authorSelfCheck": {
          "type": "string"
        }
      },
      "required": [
        "workflowMode",
        "implPlanPaths"
      ]
    },
    "maxValidationAttempts": 2
  }
}
