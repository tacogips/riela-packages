{
  "id": "dispatch-plans",
  "description": "Select the next dependency-ready wave for native Riela fanout. Do not spawn agents or nested CLI processes yourself.",
  "executionBackend": "codex-agent",
  "model": "gpt-5.6-sol",
  "promptTemplateFile": "prompts/dispatch-plans.md",
  "variables": {},
  "effort": "high",
  "output": {
    "description": "Return every implementation item with the complete accepted review context required by isolated fanout branches.",
    "jsonSchema": {
      "type": "object",
      "properties": {
        "implementationItems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "planId": { "type": "string", "minLength": 1 },
              "planPath": { "type": "string", "minLength": 1 },
              "dependsOn": { "type": "array", "items": { "type": "string" } },
              "writePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "sharedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "trackedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
              "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
              "verification": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "reviewContext": {
                "type": "object",
                "properties": {
                  "issueReference": { "type": "string", "minLength": 1 },
                  "userProblem": { "type": "string", "minLength": 1 },
                  "requiredOutcomes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
                  "nonGoals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "designDecisionsAndRationale": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "intentionalTradeoffs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "supportedEdgeCases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "outOfScopeEdgeCases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "sourcePaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
                },
                "required": ["issueReference", "userProblem", "requiredOutcomes", "nonGoals", "constraints", "designDecisionsAndRationale", "intentionalTradeoffs", "supportedEdgeCases", "outOfScopeEdgeCases", "sourcePaths"],
                "additionalProperties": false
              },
              "manifestPath": { "type": "string", "minLength": 1 },
              "checkpointCommit": { "type": "string", "minLength": 1 },
              "implementationBranch": { "type": "string", "minLength": 1 },
              "baseBranch": { "type": "string", "minLength": 1 },
              "remote": { "type": "string", "minLength": 1 },
              "evidenceRoot": { "type": "string", "minLength": 1 }
            },
            "required": ["planId", "planPath", "dependsOn", "writePaths", "sharedPaths", "trackedPaths", "acceptanceCriteria", "verification", "reviewContext", "manifestPath", "checkpointCommit", "implementationBranch", "baseBranch", "remote", "evidenceRoot"],
            "additionalProperties": false
          }
        },
        "acceptedPlanIds": { "type": "array", "items": { "type": "string" } },
        "manifestPath": { "type": "string", "minLength": 1 },
        "checkpointCommit": { "type": "string", "minLength": 1 }
      },
      "required": ["implementationItems", "acceptedPlanIds", "manifestPath", "checkpointCommit"],
      "additionalProperties": false
    }
  }
}
