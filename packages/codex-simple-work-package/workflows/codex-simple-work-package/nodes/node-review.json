{
  "id": "review",
  "description": "Review the simple-work diff and request a rerun only for high or middle findings.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "effort": "medium",
  "promptTemplateFile": "prompts/review.md",
  "variables": {},
  "output": {
    "description": "Return adapter JSON with when.needs_revision true only when high or middle findings exist, plus findings and actionable feedback.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "needs_revision": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "middle",
                  "low"
                ]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "severity",
              "file",
              "message"
            ],
            "additionalProperties": true
          }
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "needs_revision",
        "findings",
        "feedback",
        "accepted"
      ]
    },
    "maxValidationAttempts": 2
  }
}
