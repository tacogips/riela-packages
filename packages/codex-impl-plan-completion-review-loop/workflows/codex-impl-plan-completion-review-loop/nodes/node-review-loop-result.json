{
  "id": "review-loop-result",
  "description": "Summarize the codex-recent-change-quality-loop result.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/review-loop-result.md",
  "variables": {},
  "output": {
    "description": "Return accepted review status, review window, fix iterations, delegated runs, verification, changed files, and residual low risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reviewLoopWorkflowId": {
          "type": "string"
        },
        "reviewStatus": {
          "type": "string"
        },
        "reviewedRange": {
          "type": "string"
        },
        "finalFindings": {
          "type": "array",
          "items": {}
        },
        "fixIterations": {
          "type": "integer"
        },
        "reviewDelegatedWorkflowRuns": {
          "type": "array",
          "items": {}
        },
        "reviewChangedFiles": {
          "type": "array",
          "items": {}
        },
        "reviewVerification": {
          "type": "array",
          "items": {}
        },
        "reviewResidualLowRisks": {
          "type": "array",
          "items": {}
        },
        "operatorNotes": {
          "type": "array",
          "items": {}
        },
        "implementationEvidence": {
          "type": "object"
        }
      },
      "required": [
        "reviewLoopWorkflowId",
        "reviewStatus"
      ]
    },
    "maxValidationAttempts": 2
  }
}
