{
  "id": "impl-loop-result",
  "description": "Summarize the codex-impl-plan-completion-loop result.",
  "executionBackend": "codex-agent",
  "agentSandbox": "read-only",
  "model": "gpt-5.6-sol",
  "modelFreeze": false,
  "promptTemplateFile": "prompts/impl-loop-result.md",
  "variables": {},
  "output": {
    "description": "Return implementation completion status, delegated runs, changed files, verification evidence, and residual risks.",
    "jsonSchema": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "implLoopWorkflowId": {
          "type": "string"
        },
        "implLoopStatus": {
          "type": "string"
        },
        "completedPlans": {
          "type": "array",
          "items": {}
        },
        "activePlansRemaining": {
          "type": "array",
          "items": {}
        },
        "delegatedWorkflowRuns": {
          "type": "array",
          "items": {}
        },
        "implementationChangedFiles": {
          "type": "array",
          "items": {}
        },
        "implementationVerification": {
          "type": "array",
          "items": {}
        },
        "implementationResidualRisks": {
          "type": "array",
          "items": {}
        },
        "reviewInput": {
          "type": "object"
        },
        "handoffSummary": {
          "type": "string"
        }
      },
      "required": [
        "implLoopWorkflowId",
        "implLoopStatus"
      ]
    },
    "maxValidationAttempts": 2
  }
}
